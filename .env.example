# AudioGraph-AI Environment Configuration Example
# Copy this file to .env and adjust variables as desired.

# -----------------------------------------------------------------------------
# 1. RANDOM SEED (for reproducible sampling stream)
# -----------------------------------------------------------------------------
# Set an integer seed for 100% reproducible random recommendations.
# Set to 'random', 'none', or leave blank for a fresh random stream on every run.
RANDOM_SEED=42

# -----------------------------------------------------------------------------
# 2. STARTING SEED TRACK SELECTION OPTIONS (Choose one)
# -----------------------------------------------------------------------------
# Option A: Start from a specific Spotify track_id (e.g. 'Comedy' by Gen Hoshino)
# SEED_TRACK_ID=5SuOikwiRyPMVoIQDJUgSV

# Option B: Start from a specific track row index in the dataset (0 to N-1)
# SEED_INDEX=0

# Option C: Unified SEED variable (auto-detects track_id, index, or 'random')
# SEED=random
